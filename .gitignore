# Never commit raw or clean data
raw-staging/
clean-staging/
logs/

# Promote staging — sanitized markdown is still vault-bound personal
# data (subject lines, chat transcripts, calendar context). Default
# location when promote_staging_dir is unset in config/local.json.
promote-staging/
sanitizer-promote-staging/

# Never commit the mapping file or its review queue.
# mapping/*.json covers the current M2/M3 unencrypted format; mapping.enc
# is the future encrypted-at-rest format per the pipeline architecture.
mapping/mapping.enc
mapping/mapping.review.jsonl
mapping/*.json
mapping/*.key

# Standard Python/Node
.env
.venv/
node_modules/
__pycache__/
*.pyc
.DS_Store

# Claude
CLAUDE.md
.claude/settings.local.json

# Project docs — kept local only (contain provider/pet/first-name references)
files/
files.zip

# VS Code Local History — stores snapshots of every save, may contain past versions of sensitive files
.history/

# Tool caches
.pytest_cache/
.ruff_cache/

# Ground-truth fixtures stay local-only — synthetic-shaped PII still pattern-matches
# as credential / address / SSN data and shouldn't end up on a public-facing host.
# The README is kept as a generic scaffold so future-you can rebuild the tree.
tests/fixtures/ground-truth/*
!tests/fixtures/ground-truth/README.md

# Local pipeline config — real paths, self-identity, keep-list.
config/local.json