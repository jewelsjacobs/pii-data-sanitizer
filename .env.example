# iCloud IMAP app-specific password for apple-mail adapter.
# Generate at: https://account.apple.com/account/manage → App-Specific Passwords.
# The real .env lives next to this file, has chmod 600, and is gitignored.
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# iCloud email address (the account to authenticate as).
ICLOUD_EMAIL=you@icloud.com
